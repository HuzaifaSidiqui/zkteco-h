# =====================================================================
# ZKTeco uFace800 to Odoo Attendance Relay Service Configuration
# =====================================================================

# Ingress / Reverse Proxy (Domain pointed to this server's public IP)
DOMAIN=relay.yourdomain.com

# PostgreSQL Database Configuration
POSTGRES_USER=relay_user
POSTGRES_PASSWORD=relay_secure_password_replace_me
POSTGRES_DB=relay_db
# For Docker Compose, the internal URL is:
DATABASE_URL=postgresql://relay_user:relay_secure_password_replace_me@db:5432/relay_db
# For local testing without PostgreSQL, uncomment:
# DATABASE_URL=sqlite:///./relay_local.db

# Odoo Online Instance Configuration
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany-production
ODOO_USERNAME=attendance_relay@yourcompany.com
ODOO_PASSWORD=your_odoo_api_key_or_password

# Odoo Employee Matching Field (field on hr.employee containing device user PIN/badge)
# Common options: "barcode" (default badge ID), "identification_id", "pin"
ODOO_EMPLOYEE_PIN_FIELD=barcode

# Odoo Attendance Device Tracking Field (optional custom Char field on hr.attendance)
# If this field does not exist in your Odoo DB, the relay will probe and gracefully skip it
ODOO_DEVICE_FIELD=x_zk_device_sn

# Security & Admin Access
# Required for GET /admin, GET /admin/status, and POST /admin/refresh-employees
ADMIN_TOKEN=generate-a-strong-random-token-here-32chars

# Device Health Alerting
# Threshold in minutes without an ADMS heartbeat ping before triggering an alert
HEARTBEAT_MINUTES=15

# Alert Webhook URL (Supports Slack, Discord, Telegram relay, or generic webhook)
# Leave blank to disable webhook alerts
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.example.com/alerts

# Configured Devices (JSON list of up to 5 uFace800 terminals)
# Any request from a Serial Number NOT in this list is rejected and logged
DEVICES='[
  {"sn": "CJ49193260001", "site_name": "HQ - Main Entrance", "label": "HQ Front Gate"},
  {"sn": "CJ49193260002", "site_name": "HQ - Warehouse", "label": "HQ Warehouse Back"},
  {"sn": "CJ49193260003", "site_name": "Downtown Office", "label": "Branch 1 Lobby"},
  {"sn": "CJ49193260004", "site_name": "Uptown Office", "label": "Branch 2 Lobby"},
  {"sn": "CJ49193260005", "site_name": "Manufacturing Plant", "label": "Factory Floor Gate"}
]'

# Timezone configured on the physical biometric terminals
# Used to interpret naive timestamp from device and convert to UTC for Odoo
DEVICE_TIMEZONE=UTC

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =====================================================================
# ZKTeco iClock Handshake Defaults (ADMS registration response options)
# =====================================================================
ICLOCK_STAMP=9999
ICLOCK_OPSTAMP=9999
ICLOCK_ERROR_DELAY=60
ICLOCK_DELAY=30
ICLOCK_TRANS_TIMES=00:00;23:59
ICLOCK_TRANS_INTERVAL=1
ICLOCK_TRANS_FLAG=1111000000
ICLOCK_REALTIME=1
ICLOCK_ENCRYPT=0
